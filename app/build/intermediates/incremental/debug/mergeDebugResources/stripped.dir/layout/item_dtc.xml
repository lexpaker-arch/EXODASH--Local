<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dtcCodigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P0301"
            android:textColor="#00FFCC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/dtcStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ATIVO"
            android:textColor="#FF3333"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:layout_marginStart="12dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="#2A0A0A" />
    </LinearLayout>

    <TextView
        android:id="@+id/dtcDescricao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Falha de ignicao no cilindro 1"
        android:textColor="#E8E8E8"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/dtcDatas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Detectado em 23/09/2026 as 15:30"
        android:textColor="#666666"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />
</LinearLayout>
