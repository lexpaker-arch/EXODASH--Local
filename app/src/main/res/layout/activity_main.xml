<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_metallic"
    android:padding="20dp">

    <!-- ========== HEADER ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EXODASH"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/carroNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#D4AF37"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:id="@+id/statusExo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXO: ON"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="10dp" />
                <TextView
                    android:id="@+id/statusObd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OBD: ON"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
            <!-- IDs ocultos para não quebrar o Kotlin -->
            <TextView android:id="@+id/carroSub" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/statusUser" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end">
            <LinearLayout
                android:id="@+id/btnConfig"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙"
                    android:textColor="#64748B"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========== ÁREA CENTRAL ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- TELEMETRIA (Grade 2x2 + Velocidade) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">
            
            <!-- Velocidade -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VELOCIDADE"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/telSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#00FFCC"
                    android:textSize="48sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Grade 2x2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RPM" android:textColor="#64748B" android:textSize="9sp" />
                    <TextView android:id="@+id/telRpm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#F8FAFC" android:textSize="22sp" android:fontFamily="monospace" />
                    <ProgressBar android:id="@+id/fuelBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp" android:progressDrawable="@drawable/barra_progress" />
                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MOTOR" android:textColor="#64748B" android:textSize="9sp" />
                    <TextView android:id="@+id/telTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#F8FAFC" android:textSize="22sp" android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMBUSTÍVEL" android:textColor="#64748B" android:textSize="9sp" />
                    <TextView android:id="@+id/telFuel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#F8FAFC" android:textSize="22sp" android:fontFamily="monospace" />
                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BATERIA" android:textColor="#64748B" android:textSize="9sp" />
                    <TextView android:id="@+id/telBattery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#F8FAFC" android:textSize="22sp" android:fontFamily="monospace" />
                    <ProgressBar android:id="@+id/batteryBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp" android:progressDrawable="@drawable/barra_progress" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="15dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUTONOMIA" android:textColor="#64748B" android:textSize="9sp" />
                <TextView android:id="@+id/telAutonomia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- km" android:textColor="#F8FAFC" android:textSize="22sp" android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <!-- BOTÃO EXO (Centro) -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            
            <!-- Anel externo simulado -->
            <View
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/boss_glow" />
                
            <Button
                android:id="@+id/bossButton"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:text="EXO"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#00FFCC"
                android:background="@drawable/boss_button_bg"
                android:stateListAnimator="@null" />
        </FrameLayout>

        <!-- DIREITA (Relógio, Música, Clima) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Relógio -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">
                <TextView
                    android:id="@+id/clockTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#F8FAFC"
                    android:textSize="56sp"
                    android:fontFamily="sans-serif-thin" />
                <TextView
                    android:id="@+id/clockSeconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":--"
                    android:textColor="#64748B"
                    android:textSize="16sp"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="10dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/clockDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:letterSpacing="0.1" />
            <!-- ID oculto para não quebrar o Kotlin -->
            <TextView android:id="@+id/clockDay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            <!-- Música -->
            <LinearLayout
                android:id="@+id/musicFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:layout_marginTop="20dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="🎵"
                    android:gravity="center"
                    android:background="@drawable/barra_trilha"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/musicTrack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="---"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/musicArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="---"
                        android:textColor="#64748B"
                        android:textSize="10sp" />
                </LinearLayout>
                <!-- ID oculto para o progresso não quebrar -->
                <View android:id="@+id/musicProgress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========== RODAPÉ ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        android:paddingTop="15dp">

        <!-- Triângulo de DTC (Esquerda) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical">
            <LinearLayout
                android:id="@+id/errorTriangle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲"
                    android:textColor="#EF4444"
                    android:textSize="28sp"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/errorTriangleCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#EF4444"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Atalhos (Centro) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            
            <LinearLayout android:id="@+id/btnTelefone" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:layout_marginEnd="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📞" android:textSize="22sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEL" android:textColor="#64748B" android:textSize="8sp" android:layout_marginTop="2dp" />
            </LinearLayout>
            
            <LinearLayout android:id="@+id/btnMidia" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:layout_marginEnd="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎵" android:textSize="22sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MÍDIA" android:textColor="#64748B" android:textSize="8sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnGps" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:layout_marginEnd="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textSize="22sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPS" android:textColor="#64748B" android:textSize="8sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnApps" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▦" android:textSize="22sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="APPS" android:textColor="#64748B" android:textSize="8sp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Branding (Direita) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXODRIVE"
                android:textColor="#475569"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BY ALEX. P"
                android:textColor="#334155"
                android:textSize="8sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>