<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_metallic"
    android:padding="24dp">

    <!-- ========== HEADER ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EXODASH"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:fontFamily="@font/inter_regular"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/carroNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#D4AF37"
                android:textSize="18sp"
                android:fontFamily="@font/inter_regular"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/statusExo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXO: ON"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:fontFamily="@font/roboto_mono"
                    android:layout_marginEnd="12dp" />
                <TextView
                    android:id="@+id/statusObd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OBD: ON"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:fontFamily="@font/roboto_mono" />
            </LinearLayout>
            <TextView android:id="@+id/carroSub" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/statusUser" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end">
            <LinearLayout
                android:id="@+id/btnConfig"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========== ÁREA CENTRAL ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- TELEMETRIA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VELOCIDADE"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_regular"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/telSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#00FFCC"
                    android:textSize="52sp"
                    android:fontFamily="@font/roboto_mono"
                    android:textStyle="bold"
                    android:letterSpacing="-0.05" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RPM" android:textColor="#64748B" android:textSize="9sp" android:fontFamily="@font/inter_regular" />
                    <TextView android:id="@+id/telRpm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#F8FAFC" android:textSize="24sp" android:fontFamily="@font/roboto_mono" />
                    <ProgressBar android:id="@+id/fuelBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="6dp" android:progressDrawable="@drawable/barra_progress" />
                </LinearLayout>
                
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MOTOR" android:textColor="#64748B" android:textSize="9sp" android:fontFamily="@font/inter_regular" />
                    <TextView android:id="@+id/telTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#F8FAFC" android:textSize="24sp" android:fontFamily="@font/roboto_mono" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMBUSTÍVEL" android:textColor="#64748B" android:textSize="9sp" android:fontFamily="@font/inter_regular" />
                    <TextView android:id="@+id/telFuel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#F8FAFC" android:textSize="24sp" android:fontFamily="@font/roboto_mono" />
                </LinearLayout>
                
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BATERIA" android:textColor="#64748B" android:textSize="9sp" android:fontFamily="@font/inter_regular" />
                    <TextView android:id="@+id/telBattery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#F8FAFC" android:textSize="24sp" android:fontFamily="@font/roboto_mono" />
                    <ProgressBar android:id="@+id/batteryBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="6dp" android:progressDrawable="@drawable/barra_progress" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUTONOMIA" android:textColor="#64748B" android:textSize="9sp" android:fontFamily="@font/inter_regular" />
                <TextView android:id="@+id/telAutonomia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- km" android:textColor="#F8FAFC" android:textSize="24sp" android:fontFamily="@font/roboto_mono" />
            </LinearLayout>
        </LinearLayout>

        <!-- BOTÃO EXO (Centro) -->
        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            
            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:background="@drawable/boss_glow" />
                
            <Button
                android:id="@+id/bossButton"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:text="EXO"
                android:textSize="20sp"
                android:fontFamily="@font/inter_regular"
                android:textStyle="bold"
                android:textColor="#00FFCC"
                android:background="@drawable/boss_button_bg"
                android:stateListAnimator="@null" />
        </FrameLayout>

        <!-- DIREITA (Relógio, Música) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">
                <TextView
                    android:id="@+id/clockTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="#F8FAFC"
                    android:textSize="60sp"
                    android:fontFamily="@font/inter_light" />
                <TextView
                    android:id="@+id/clockSeconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":--"
                    android:textColor="#64748B"
                    android:textSize="16sp"
                    android:fontFamily="@font/roboto_mono"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="12dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/clockDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:fontFamily="@font/inter_regular"
                android:letterSpacing="0.1" />
            <TextView android:id="@+id/clockDay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            <LinearLayout
                android:id="@+id/musicFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:layout_marginTop="24dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_music"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/musicTrack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="---"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/musicArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MP3 LOCAL"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>
                <View android:id="@+id/musicProgress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========== RODAPÉ ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical">
            <LinearLayout
                android:id="@+id/errorTriangle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲"
                    android:textColor="#EF4444"
                    android:textSize="28sp"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/errorTriangleCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#EF4444"
                    android:textSize="16sp"
                    android:fontFamily="@font/roboto_mono"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            
            <LinearLayout android:id="@+id/btnTelefone" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:layout_marginEnd="20dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_phone" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEL" android:textColor="#64748B" android:textSize="8sp" android:fontFamily="@font/inter_regular" android:layout_marginTop="4dp" />
            </LinearLayout>
            
            <LinearLayout android:id="@+id/btnMidia" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:layout_marginEnd="20dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_music" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MÍDIA" android:textColor="#64748B" android:textSize="8sp" android:fontFamily="@font/inter_regular" android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnGps" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:layout_marginEnd="20dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_gps" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPS" android:textColor="#64748B" android:textSize="8sp" android:fontFamily="@font/inter_regular" android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnApps" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_apps" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="APPS" android:textColor="#64748B" android:textSize="8sp" android:fontFamily="@font/inter_regular" android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXODRIVE"
                android:textColor="#475569"
                android:textSize="10sp"
                android:fontFamily="@font/inter_regular"
                android:textStyle="bold"
                android:letterSpacing="0.2" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BY ALEX. P"
                android:textColor="#334155"
                android:textSize="8sp"
                android:fontFamily="@font/inter_regular"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
