<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Botão Voltar -->
        <LinearLayout
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#00FFCC"
                android:textSize="22sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOLTAR"
                android:textColor="#00FFCC"
                android:textSize="12sp"
                android:letterSpacing="0.2" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXODASH Config"
            android:textColor="#C0C0C0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BY ALEX. P"
            android:textColor="#666666"
            android:textSize="9sp"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.2" />

        <!-- ===== PERFIS ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERFIS"
            android:textColor="#00FFCC"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome do usuário"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtNomeUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senhor"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNomeUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="#00FFCC"
                android:backgroundTint="#0A2A2A" />
        </LinearLayout>

        <!-- ===== ATALHOS ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ATALHOS"
            android:textColor="#00FFCC"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telefone"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/txtEscolhaTelefone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Padrão do sistema"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnEscolherTelefone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escolher"
                android:textColor="#00FFCC"
                android:backgroundTint="#0A2A2A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mídia"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/txtEscolhaMidia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Não escolhido"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnEscolherMidia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escolher"
                android:textColor="#00FFCC"
                android:backgroundTint="#0A2A2A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/txtEscolhaGps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Padrão do sistema"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnEscolherGps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escolher"
                android:textColor="#00FFCC"
                android:backgroundTint="#0A2A2A" />
        </LinearLayout>

        <!-- ===== VOZ ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOZ"
            android:textColor="#00FFCC"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Voz ativa"
                android:textColor="#E8E8E8"
                android:textSize="13sp" />
            <Switch
                android:id="@+id/swVozAtiva"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bipe antes de falar"
                android:textColor="#E8E8E8"
                android:textSize="13sp" />
            <Switch
                android:id="@+id/swBipeAtivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ===== OBD ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OBD"
            android:textColor="#00FFCC"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Host"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/txtObdHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="127.0.0.1"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnEditarObd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="#00FFCC"
                android:backgroundTint="#0A2A2A" />
        </LinearLayout>

        <!-- ===== VEÍCULO ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VEÍCULO"
            android:textColor="#00FFCC"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marca / Modelo / Ano"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/txtVeiculo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Não informado"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnEditarVeiculo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="#00FFCC"
                android:backgroundTint="#0A2A2A" />
        </LinearLayout>

        <!-- ===== INTELIGÊNCIA ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTELIGÊNCIA"
            android:textColor="#00FFCC"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API Groq"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/txtGroqStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Não configurada"
                    android:textColor="#FF3333"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnEditarGroq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="#00FFCC"
                android:backgroundTint="#0A2A2A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Modo"
                android:textColor="#E8E8E8"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/txtModoIA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online → Offline"
                android:textColor="#00FFCC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== DIAGNOSTICO ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIAGNOSTICO"
            android:textColor="#00FFCC"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/btnVerDtc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Codigos de falha"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtDtcResumo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nenhum registro"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#666666"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ===== TESTE (temporario) ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TESTE"
            android:textColor="#FFAA00"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/btnSimularDtc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Simular DTC"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adiciona um codigo de teste (P0301)"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#666666"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ===== ATUALIZAÇÃO ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ATUALIZAÇÃO"
            android:textColor="#00FFCC"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Verificar automaticamente"
                android:textColor="#E8E8E8"
                android:textSize="13sp" />
            <Switch
                android:id="@+id/swAutoUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Versão atual"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/txtVersaoAtual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnVerificarUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verificar agora"
                android:textColor="#00FFCC"
                android:backgroundTint="#0A2A2A" />
        </LinearLayout>

        <!-- ===== SOBRE ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOBRE"
            android:textColor="#00FFCC"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/btnLimparCache">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Limpar cache"
                android:textColor="#E8E8E8"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#666666"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/btnSobre">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sobre o EXODASH"
                android:textColor="#E8E8E8"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#666666"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>
