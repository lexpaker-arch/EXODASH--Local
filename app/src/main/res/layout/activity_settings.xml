<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <include layout="@layout/include_header" />

        <TextView style="@style/ExoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERFIS"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <LinearLayout style="@style/ExoCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/ExoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome do usuario" />
                    <TextView
                        android:id="@+id/txtNomeUsuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Senhor"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnNomeUsuario"
                    style="@style/ExoButton.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:text="Editar" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/ExoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ATALHOS"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <LinearLayout style="@style/ExoCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/ExoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telefone" />
                    <TextView
                        android:id="@+id/txtEscolhaTelefone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Padrao do sistema"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnEscolherTelefone"
                    style="@style/ExoButton.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:text="Escolher" />
            </LinearLayout>

            <View style="@style/ExoDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/ExoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Midia" />
                    <TextView
                        android:id="@+id/txtEscolhaMidia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nao escolhido"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnEscolherMidia"
                    style="@style/ExoButton.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:text="Escolher" />
            </LinearLayout>

            <View style="@style/ExoDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/ExoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS" />
                    <TextView
                        android:id="@+id/txtEscolhaGps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Padrao do sistema"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnEscolherGps"
                    style="@style/ExoButton.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:text="Escolher" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/ExoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOZ"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <LinearLayout style="@style/ExoCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView style="@style/ExoValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Voz ativa" />
                <Switch
                    android:id="@+id/swVozAtiva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/ExoDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView style="@style/ExoValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bipe antes de falar" />
                <Switch
                    android:id="@+id/swBipeAtivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/ExoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OBD"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <LinearLayout style="@style/ExoCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/ExoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Host" />
                    <TextView
                        android:id="@+id/txtObdHost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="127.0.0.1:35000"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnEditarObd"
                    style="@style/ExoButton.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:text="Editar" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/ExoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VEICULO"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <LinearLayout style="@style/ExoCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/ExoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marca / Modelo / Ano" />
                    <TextView
                        android:id="@+id/txtVeiculo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nao informado"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnEditarVeiculo"
                    style="@style/ExoButton.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:text="Editar" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/ExoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTELIGENCIA"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <LinearLayout style="@style/ExoCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView style="@style/ExoValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Modo" />
                <TextView
                    android:id="@+id/txtModoIA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online → Offline"
                    android:textColor="@color/cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/ExoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIAGNOSTICO"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <LinearLayout style="@style/ExoCard">
            <LinearLayout
                android:id="@+id/btnVerDtc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/ExoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Codigos de falha" />
                    <TextView
                        android:id="@+id/txtDtcResumo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nenhum registro"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textColor="@color/gray"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/ExoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOGS"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <LinearLayout style="@style/ExoCard">
            <LinearLayout
                android:id="@+id/btnVerLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/ExoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Eventos do sistema" />
                    <TextView
                        android:id="@+id/txtLogsResumo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nenhum registro"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textColor="@color/gray"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/ExoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ATUALIZACAO"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <LinearLayout style="@style/ExoCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/ExoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Versao" />
                    <TextView
                        android:id="@+id/txtVersao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v1.0.0"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnVerificarAtualizacao"
                    style="@style/ExoButton.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:text="Verificar" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/ExoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SISTEMA"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <LinearLayout style="@style/ExoCard">
            <LinearLayout
                android:id="@+id/btnSobre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">
                <TextView style="@style/ExoValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sobre o EXODASH" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textColor="@color/gray"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
