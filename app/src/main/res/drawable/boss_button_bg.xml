<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Anel externo (mais fino) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#8000FFCC" />
        </shape>
    </item>
    <!-- Anel interno (mais grosso, afastado) -->
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#0A2A2A" />
            <stroke android:width="3dp" android:color="#00FFCC" />
        </shape>
    </item>
</layer-list>
