<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Anel externo tracejado simulado (fino, translucido) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#7000FFCC" />
        </shape>
    </item>
    <!-- Anel interno segmentado (topo e base em ciano forte) -->
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="oval">
            <solid android:color="#0A2A2A" />
            <stroke android:width="3dp" android:color="#00FFCC" />
        </shape>
    </item>
    <!-- Nucleo escuro central com brilho -->
    <item android:left="20dp" android:top="20dp" android:right="20dp" android:bottom="20dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:startColor="#0A3A3A"
                android:endColor="#000000" />
        </shape>
    </item>
</layer-list>
