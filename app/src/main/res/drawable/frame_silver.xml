<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Moldura externa prateada -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
            <stroke android:width="3dp" android:color="#C0C0C0" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Linha interna ciano, com espaçamento -->
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#4000FFCC" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
